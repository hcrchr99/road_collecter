# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Vercel ----
# 只忽略本地 CLI 关联文件，保留 .vercel/project.json（不含密钥，用于共享项目设置）
.vercel/.env.*
.vercel/output/
.vercel/cache/
.vercelignore 是部署配置，需要入库，不要在这里忽略

# ---- 临时文件 ----
*.tmp
~$*
_*.txt
!reports/*.txt
